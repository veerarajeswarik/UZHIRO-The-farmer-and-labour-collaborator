# Copy to .env for local development.
#
# IMPORTANT: every VITE_* variable is bundled into the public JavaScript that
# browsers download. It is NOT secret. Never put API keys, database URLs or
# passwords here - those belong only in the backend's environment.

# Backend API base URL.
# - Local dev: http://localhost:5000/api
# - Production (Netlify env var): your Render URL + /api,
#   e.g. https://uzhiro-api.onrender.com/api  (the production build fails without it)
VITE_API_URL=http://localhost:5000/api
