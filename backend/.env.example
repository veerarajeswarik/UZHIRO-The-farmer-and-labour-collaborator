# Copy this file to .env and fill in real values. Never commit .env.

# Server
NODE_ENV=development
PORT=5000

# Frontend origin(s) allowed to call this API (CORS). Comma-separated, no
# trailing slash. REQUIRED in production - set it to your Netlify URL, e.g.
#   CLIENT_URL=https://uzhiro.netlify.app
# (In development any http://localhost:<port> / 127.0.0.1 origin is also allowed.)
CLIENT_URL=http://localhost:5173

# MongoDB
# Local example: mongodb://127.0.0.1:27017/uzhiro
# Atlas example: mongodb+srv://<user>:<password>@<cluster>/uzhiro
MONGODB_URI=

# JWT - use 32+ random characters (the server refuses to start in production
# otherwise). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Weather - Open-Meteo (open-meteo.com). Free, no API key required.

# AI Farming Assistant - Anthropic Claude API. Get a key at
# https://console.anthropic.com. Without a key, the chat endpoint honestly
# reports itself as unavailable rather than fabricating a reply.
# NOTE: the variable must be named exactly ANTHROPIC_API_KEY (not AI_API_KEY).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Market prices - data.gov.in Agmarknet (Current Daily Price of Various
# Commodities from Various Markets / Mandi). Get a free key by registering
# at https://data.gov.in (My Account > API Keys). Without a key, the app
# honestly reports market price as unavailable and falls back to the
# example selling price - it never invents a live price.
AGMARKNET_API_KEY=
